# ============================================
# 函证地址核查 - 配置文件模板
# ============================================
# 复制此文件为 .env 并填入你的 Key
#   cp .env.example .env
# ============================================

# 腾讯地图 API Key（免费注册：https://lbs.qq.com/）
TENCENT_MAP_KEY=your_tencent_map_key_here

# DeepSeek API Key（https://platform.deepseek.com/）
# 也支持任何 OpenAI 兼容接口，修改 LLM_BASE_URL 即可
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM 配置（可选，默认值如下）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# AnySearch CLI 路径（可选，需自行安装 AnySearch）
# ANYSEARCH_CLI=/path/to/anysearch_cli.py
